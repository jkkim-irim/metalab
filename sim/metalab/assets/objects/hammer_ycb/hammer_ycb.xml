<mujoco model="hammer_ycb">
  <compiler meshdir="meshes" texturedir="meshes" angle="radian"/>
  <!-- The YCB 048_hammer scan RESHAPED to be one variant of a multi-shape hammer object beside
       hammer_cylinder / hammer_edge / hammer_rect. Derived from ycb_048_hammer_grasp_offset (same frame,
       same textured visual mesh, mesh files keep their original names so provenance stays readable).

       newton's SolverMuJoCo requires homogeneous worlds, and its geom -> shape map is by LOCAL SLOT INDEX,
       not by collision flag: a variant must carry the same shape COUNT and put its COLLIDING shapes at the
       same slots as every other variant, or the solver silently collides world w's hammer against whatever
       sits in those slots there. The hammer_* assets are 4 visual then 4 collision, so this one is too:

         model=       "hammer_ycb", not the source folder's name — newton labels the imported body
                      "<model>/worldbody/object" and groups contact_params by that prefix, so every variant
                      of an object named "hammer" needs the hammer_ prefix.
         slots 0-3    the textured visual mesh + THREE padding copies of the smallest hull, rgba alpha 0 so
                      they draw as nothing. class="visual" is contype/conaffinity 0 and density 0, so the
                      padding moves no mass, no inertia and no contact — only the slot count.
         slots 4-7    FOUR collision hulls, where the source has five: its hull3 and hull4 (12.8 and 10.4
                      cm3, adjacent on the claw) are replaced by hull34, the convex hull of the two. Sampled
                      against the source's 5-hull union: +3.73 cm3 added, 0.01 cm3 lost on a 368 cm3 object.
                      That was the cheapest of the three ways to reach four (CoACD re-run at max 4 parts:
                      +59.05 / -12.22; dropping hull4 outright: -10.44).

       Contact params are NOT authored here: solref/solimp live in the task contract's contact_params, and
       friction is left at MuJoCo's own default (1 0.005 0.0001), overridden per env at reset by the
       set_shape_friction DR event. Mass is not authored either: ObjectSpec.mass is written in by
       contract/mjcf_prep.prepare_object_mjcf (inertia rescaled with it). -->
  <default>
    <default class="visual"><geom contype="0" conaffinity="0" group="2" density="0"/></default>
    <default class="collision"><geom group="3"/></default>
  </default>
  <asset>
    <texture name="ycb_048_hammer_grasp_offset_tex" type="2d" file="ycb_048_hammer_grasp_offset_texture.png"/>
    <material name="ycb_048_hammer_grasp_offset_mat" texture="ycb_048_hammer_grasp_offset_tex" specular="0.2" shininess="0.3"/>
    <mesh name="ycb_048_hammer_grasp_offset_visual" file="ycb_048_hammer_grasp_offset_visual.obj"/>
    <mesh name="ycb_048_hammer_grasp_offset_hull0" file="ycb_048_hammer_grasp_offset_hull0.obj"/>
    <mesh name="ycb_048_hammer_grasp_offset_hull1" file="ycb_048_hammer_grasp_offset_hull1.obj"/>
    <mesh name="ycb_048_hammer_grasp_offset_hull2" file="ycb_048_hammer_grasp_offset_hull2.obj"/>
    <mesh name="ycb_048_hammer_grasp_offset_hull34" file="ycb_048_hammer_grasp_offset_hull34.obj"/>
  </asset>
  <worldbody>
    <body name="object" pos="0 0 0">
      <freejoint name="object_free"/>
      <geom type="mesh" mesh="ycb_048_hammer_grasp_offset_visual" material="ycb_048_hammer_grasp_offset_mat" class="visual"/>
      <geom type="mesh" mesh="ycb_048_hammer_grasp_offset_hull2" class="visual" rgba="0 0 0 0"/>
      <geom type="mesh" mesh="ycb_048_hammer_grasp_offset_hull2" class="visual" rgba="0 0 0 0"/>
      <geom type="mesh" mesh="ycb_048_hammer_grasp_offset_hull2" class="visual" rgba="0 0 0 0"/>
      <geom type="mesh" mesh="ycb_048_hammer_grasp_offset_hull0" class="collision"/>
      <geom type="mesh" mesh="ycb_048_hammer_grasp_offset_hull1" class="collision"/>
      <geom type="mesh" mesh="ycb_048_hammer_grasp_offset_hull2" class="collision"/>
      <geom type="mesh" mesh="ycb_048_hammer_grasp_offset_hull34" class="collision"/>
    </body>
  </worldbody>
</mujoco>
